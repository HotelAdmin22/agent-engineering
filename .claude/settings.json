{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python docs/rebuild_hook.py",
            "timeout": 30,
            "statusMessage": "Rebuilding architecture doc",
            "suppressOutput": true
          }
        ]
      }
    ]
  }
}
