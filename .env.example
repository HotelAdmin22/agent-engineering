# Copy to .env and fill in ONE of the two credentials below.
# .env is gitignored. Never commit a real credential.
#
# Nothing here is baked into the Docker image — compose passes these through as
# runtime environment variables only.

# --- Authentication: pick one ---

# 1. Claude subscription (recommended). Generate with:
#        claude setup-token
#    Paste the token here. This is what compose passes into the container.
CLAUDE_CODE_OAUTH_TOKEN=

# 2. API key. Use instead of the token above, not alongside it.
ANTHROPIC_API_KEY=

# --- Optional ---

# Pin the model the Phase 0 agent uses. Unset means the Claude Code CLI decides.
# ANTHROPIC_MODEL=claude-opus-5
